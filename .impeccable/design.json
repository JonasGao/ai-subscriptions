      "css": ".ds-rail{display:flex;align-items:center;gap:0;background:#1B2A33;border-bottom:4px solid #C2452D;color:#F2EFE6}.ds-rail h1{font-size:1.05rem;font-weight:700;padding:14px 26px;margin:0}.ds-rail nav{display:flex;margin-left:auto;padding:10px 26px}.ds-rail a{padding:10px 14px;color:#D8E0E2;text-decoration:none;border-left:1px solid rgba(242,239,230,.18);font-size:.82rem}.ds-rail a:hover{background:rgba(242,239,230,.10);color:#F2EFE6}.ds-rail a.ds-nav-on{background:#D9A441;color:#1B2A33;font-weight:700}.ds-rail a:focus-visible{outline:2px solid #B23A24;outline-offset:-2px}"

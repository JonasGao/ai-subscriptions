      "css": ".ds-row{display:grid;grid-template-columns:minmax(0,1fr) 34%;background:#FBFAF4;border:0;border-bottom:1px solid #C9C7BC;border-radius:0}.ds-row:nth-child(even){background:#E7E5DE}.ds-row:hover{background:#F0E5CC}.ds-row h3{font:700 .95rem system-ui,sans-serif;margin:0;padding:10px}.ds-row dl{display:flex;justify-content:space-between;gap:12px;padding:10px;margin:0}.ds-row dt{font-size:.72rem;color:#5D6A70}.ds-row dd{margin:0;font:.82rem ui-monospace,monospace;font-variant-numeric:tabular-nums;font-weight:700;text-align:right}"

      "html": "<div class=\"ds-axis-wrap\"><div class=\"ds-axis-title\">下次重置 / 周期视图</div><div class=\"ds-track\"><span>账单</span><i class=\"ds-rail-b\"><b style=\"width:62%\"></b></i></div><div class=\"ds-track\"><span>5h</span><i class=\"ds-rail-b\"><b style=\"width:84%;background:#C2452D\"></b><u style=\"left:84%\"></u></i></div><div class=\"ds-track\"><span>周</span><i class=\"ds-rail-b\"><b style=\"width:41%;background:#2E6E73\"></b></i></div><div class=\"ds-track\"><span>月</span><i class=\"ds-rail-b\"><b style=\"width:22%;background:#D9A441\"></b></i></div><p class=\"ds-when\">2026-11-08 09:00 · 剩余 2天17时</p></div>",
      "css": ".ds-axis-wrap{padding:10px 12px;border-left:1px solid #C9C7BC;background:transparent}.ds-axis-title{font:700 .68rem system-ui,sans-serif;color:#5D6A70;margin-bottom:7px}.ds-track{display:flex;align-items:center;gap:6px;margin-bottom:4px}.ds-track>span{width:26px;flex-shrink:0;font-size:.64rem;color:#5D6A70}.ds-rail-b{position:relative;flex:1;height:6px;border:1px solid #C9C7BC;background:repeating-linear-gradient(90deg,transparent 0,transparent calc(14.285% - 1px),#C9C7BC calc(14.285% - 1px),#C9C7BC 14.285%),#E4E2D9}.ds-rail-b>b{position:absolute;left:0;top:0;bottom:0;background:#1B2A33}.ds-rail-b>u{position:absolute;top:-3px;width:2px;height:12px;background:#B23A24}.ds-when{margin:8px 0 0;font:400 .68rem ui-monospace,monospace;font-variant-numeric:tabular-nums;color:#1B2A33}"

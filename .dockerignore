# Build context: repository root, but only server/ and web/ feed the image.
# Everything below is pruned to keep the context small and deterministic.

# --- version control / tooling ---
.git
.github
.husky
.claude
.codegraph
.deepseek
.pi
.remember
.mcp.json
.vscode
.serena

# --- dependencies and build output (rebuilt inside the image) ---
node_modules
web/node_modules
web/dist
server/bin
# staged SPA tree: always copied from the web stage, never from the workspace
server/internal/webui/dist
.server
coverage

# --- secrets and runtime data ---
.env
.env*
data
/server/.data

# --- docs and deploy definitions (not needed in the build) ---
docs
*.md
deploy
Makefile
Dockerfile
.dockerignore
